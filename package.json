{
  "name": "kindly-note-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "kindly-note — a typed, modern, ESM-only fork of highlight.js. Monorepo root.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.8",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,jsonc}": ["biome check --write --no-errors-on-unmatched"],
    "*.md": ["biome format --write --no-errors-on-unmatched"]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.10",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
