{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Design tokens for @kindly-note/themes-default. Each theme picks a palette + maps it to scope-level CSS custom properties. Palette colours are inspired by well-loved upstream themes (GitHub Dark, Atom One Light, Nord) but the CSS rules in the .css files are written from scratch — colour values are not copyrightable, but CSS layout and rule structure is.",
  "version": "0.1.0",
  "themes": {
    "dark": {
      "name": "kindly-note dark",
      "inspiredBy": "github-dark colour family",
      "palette": {
        "bg": "#0d1117",
        "fg": "#c9d1d9",
        "muted": "#8b949e",
        "subtle": "#30363d",
        "keyword": "#ff7b72",
        "title": "#d2a8ff",
        "constant": "#79c0ff",
        "string": "#a5d6ff",
        "builtIn": "#ffa657",
        "tag": "#7ee787",
        "deletion-fg": "#ffdcd7",
        "deletion-bg": "#67060c",
        "addition-fg": "#aff5b4",
        "addition-bg": "#033a16",
        "section": "#1f6feb",
        "bullet": "#f2cc60"
      }
    },
    "light": {
      "name": "kindly-note light",
      "inspiredBy": "atom-one-light colour family",
      "palette": {
        "bg": "#fafafa",
        "fg": "#383a42",
        "muted": "#a0a1a7",
        "subtle": "#e5e5e6",
        "keyword": "#a626a4",
        "title": "#4078f2",
        "constant": "#0184bb",
        "string": "#50a14f",
        "builtIn": "#c18401",
        "tag": "#e45649",
        "type": "#986801",
        "deletion-fg": "#cb2431",
        "deletion-bg": "#ffeef0",
        "addition-fg": "#22863a",
        "addition-bg": "#f0fff4",
        "section": "#005cc5",
        "bullet": "#735c0f"
      }
    },
    "high-contrast": {
      "name": "kindly-note high contrast",
      "inspiredBy": "Nord palette + WCAG-AAA contrast targets",
      "palette": {
        "bg": "#000000",
        "fg": "#ffffff",
        "muted": "#cccccc",
        "subtle": "#444444",
        "keyword": "#ff8888",
        "title": "#88ccff",
        "constant": "#ffff88",
        "string": "#88ff88",
        "builtIn": "#ffaa66",
        "tag": "#88ffff",
        "deletion-fg": "#000000",
        "deletion-bg": "#ff8888",
        "addition-fg": "#000000",
        "addition-bg": "#88ff88",
        "section": "#88ccff",
        "bullet": "#ffff88"
      }
    }
  },
  "fonts": {
    "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
  }
}
