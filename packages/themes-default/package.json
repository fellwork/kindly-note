{
  "name": "@kindly-note/themes-default",
  "version": "0.1.0",
  "description": "First-party CSS theme set for kindly-note: dark, light, high-contrast — plus an opt-in compat layer that lets users keep their existing hljs-* themes. CSS-only.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dark.css": "./dist/dark.css",
    "./light.css": "./dist/light.css",
    "./high-contrast.css": "./dist/high-contrast.css",
    "./compat-hljs.css": "./dist/compat-hljs.css",
    "./tokens.json": "./dist/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/dark.css",
    "./dist/light.css",
    "./dist/high-contrast.css",
    "./dist/compat-hljs.css"
  ],
  "files": [
    "dist",
    "src",
    "styles"
  ],
  "scripts": {
    "build": "tsc -b && bun run build:assets",
    "build:assets": "bun ./scripts/copy-assets.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
