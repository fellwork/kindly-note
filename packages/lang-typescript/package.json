{
  "name": "@kindly-note/lang-typescript",
  "version": "0.1.0",
  "description": "TypeScript language definition for kindly-note. Aliases: ts, tsx. Default-exports a deep-frozen LanguageDefinition built via the typed `extendLanguage()` keystone API on top of @kindly-note/lang-javascript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@kindly-note/core": "^0.1.0",
    "@kindly-note/lang-helpers": "^0.1.0",
    "@kindly-note/lang-pack-ecmascript": "^0.1.0",
    "@kindly-note/lang-javascript": "^0.1.0"
  },
  "devDependencies": {
    "@kindly-note/emitters-html": "^0.1.0",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
