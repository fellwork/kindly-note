{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": [],
    // The browser package binds to the DOM. We pull in lib.dom for the
    // type-checker only — runtime DOM access is the WHOLE point of this
    // package, but Node-built-ins are still forbidden (spec §1.2).
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "tests", "node_modules"],
  "references": [{ "path": "../core" }, { "path": "../auto-detect" }]
}
