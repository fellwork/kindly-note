{
  "name": "@kindly-note/browser",
  "version": "0.0.1",
  "description": "DOM bindings for kindly-note. Three exports: highlightAll, highlightElement, attachToDOM. Tree-shaken away on Workers/Edge. spec §1.2.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@kindly-note/core": "workspace:*",
    "@kindly-note/auto-detect": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kindly-note/auto-detect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kindly-note/core": "workspace:*",
    "@kindly-note/auto-detect": "workspace:*",
    "@kindly-note/emitters-html": "workspace:*",
    "@kindly-note/lang-json": "workspace:*",
    "happy-dom": "^15.11.7",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
