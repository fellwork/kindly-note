{
  "name": "@kindly-note/render-markdown",
  "version": "0.1.0",
  "description": "One-call markdown → safe HTML for kindly-note. renderMarkdown(src, opts) composes @kindly-note/lang-markdown (CommonMark tokeniser) + @kindly-note/emitters-markdown (semantic-HTML emitter with security-first defaults) + a sensible Highlighter, with optional code-fence language packs. CommonMark only (GFM lives in lang-markdown-gfm).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@kindly-note/core": "^0.1.0"
  },
  "dependencies": {
    "@kindly-note/emitters-markdown": "^0.1.0",
    "@kindly-note/lang-markdown": "^0.1.0"
  },
  "devDependencies": {
    "@kindly-note/core": "^0.1.0",
    "@kindly-note/lang-json": "^0.1.0",
    "@kindly-note/lang-javascript": "^0.1.0",
    "@kindly-note/lang-typescript": "^0.1.0",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
