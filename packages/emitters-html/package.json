{
  "name": "@kindly-note/emitters-html",
  "version": "0.0.1",
  "description": "Default HTML-string emitter for kindly-note. Tiered scope-to-class mapping with `kn-` default prefix.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@kindly-note/core": "workspace:*"
  },
  "devDependencies": {
    "@kindly-note/core": "workspace:*",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
