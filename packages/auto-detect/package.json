{
  "name": "@kindly-note/auto-detect",
  "version": "0.0.1",
  "description": "Heuristic language auto-detection for kindly-note. Pure function over a registered language set; mirrors upstream highlightAuto with supersetOf tie-breaking.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "src"],
  "scripts": {
    "build": "rolldown -c",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@kindly-note/core": "workspace:*"
  },
  "devDependencies": {
    "@kindly-note/lang-javascript": "workspace:*",
    "@kindly-note/lang-json": "workspace:*",
    "@kindly-note/lang-typescript": "workspace:*",
    "rolldown": "1.0.0",
    "rolldown-plugin-dts": "0.16.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
